# Local development defaults (running `npm run start:dev` on the host).
# The full stack via `docker compose up` is configured in docker-compose.yml
# and does NOT read this file.

# Postgres is exposed by docker-compose on host port 5434 (-> container 5432).
DATABASE_URL=postgresql://waas:waas_dev@localhost:5434/waas_dev
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# 3001 to avoid clashing with the Play Sports backend (which runs on 3000).
PORT=3001

# memory: no external services needed (great for quick API testing).
# prisma: requires Postgres + an applied migration (`npx prisma migrate dev`).
PERSISTENCE_MODE=memory
# memory: simulated provider. baileys: real WhatsApp (QR pairing required).
PROVIDER_MODE=memory
